# Copie para .env (fora do alcance público) e preencha. Nunca versione o .env.
APP_ENV=production
APP_URL=https://SEU-DOMINIO.com.br
APP_TZ=America/Sao_Paulo

# mysql em produção (HostMia); sqlite apenas para desenvolvimento local
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# E-mail (recuperação de senha). log = grava em storage/mail (nada é enviado). mail = função mail() do PHP. smtp = servidor SMTP.
MAIL_DRIVER=log
MAIL_FROM=nao-responder@SEU-DOMINIO.com.br
# Só se MAIL_DRIVER=smtp:
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_ENCRYPTION=tls

# Só desenvolvimento:
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=storage/bianca.sqlite
