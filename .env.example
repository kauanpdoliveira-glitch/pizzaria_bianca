# Copie para .env (fora do alcance público) e preencha. NUNCA versione o .env, chaves ou backups.
# production = loja oficial · staging = HOMOLOGAÇÃO (faixa, noindex, comandas "TESTE — NÃO PRODUZIR", impressão só com PRINT_ENABLED=1)
APP_ENV=production
APP_URL=https://SEU-DOMINIO.com.br
APP_TZ=America/Sao_Paulo

# Banco: mysql em hospedagem; sqlite apenas para desenvolvimento local
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Hospedagem sem disco persistente (ex.: serverless): sessões e imagens no banco
# SESSION_DRIVER=db
# UPLOAD_DRIVER=db

# Impressão física em homologação (só se APP_ENV=staging): 1 libera a estação a receber trabalhos
# PRINT_ENABLED=1

# QZ Tray — assinatura no SERVIDOR (chave privada nunca vai ao navegador). Arquivos fora de public/ ou conteúdo PEM com \n.
# QZ_PRIVATE_KEY_PATH=storage/qz/private-key.pem
# QZ_CERT_PATH=storage/qz/digital-certificate.txt
# QZ_PRIVATE_KEY=
# QZ_CERT=

# E-mail (recuperação de senha). log = grava em storage/mail (nada é enviado). mail = função mail() do PHP. smtp = servidor SMTP.
MAIL_DRIVER=log
MAIL_FROM=nao-responder@SEU-DOMINIO.com.br
# Só se MAIL_DRIVER=smtp:
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_ENCRYPTION=tls

# Só desenvolvimento:
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=storage/bianca.sqlite
